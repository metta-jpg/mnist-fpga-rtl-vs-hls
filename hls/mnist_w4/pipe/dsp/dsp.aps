<AutoPilot:solution xmlns:AutoPilot="com.autoesl.autopilot.solution">
    <clockList>
        <clock name="default" period="10" default="false"/>
    </clockList>
    <config>
        <config_compile complex-mul-dsp="0" pipeline_loops="0"/>
        <config_op positional0="mul" impl="dsp"/>
        <config_rtl reset="all"/>
    </config>
    <targetInfo>
        <TargetInfo value="xc7a35t:-cpg236:-1"/>
    </targetInfo>
    <libraryList>
        <library value="xilinx/artix7/artix7" name="DefaultPlatform"/>
    </libraryList>
    <flowTarget value="vivado"/>
    <name>
        <value string="dsp"/>
    </name>
    <project>
        <value string="pipe"/>
    </project>
</AutoPilot:solution>

